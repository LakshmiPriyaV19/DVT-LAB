import matplotlib.pyplot as plt
import numpy as np
import pandas as pd
import seaborn as sns

# Set visual style for academic presentation
sns.set_theme(style="whitegrid")
plt.rcParams["font.sans-serif"] = "DejaVu Sans"

# Load the dataset
df = pd.read_csv("india_cancer_patients_2022_2025.csv")
df["Diagnosis_Date"] = pd.to_datetime(df["Diagnosis_Date"])

print(df.head())
# Create pivot table
pivot_data = pd.crosstab(df["Cancer_Type"], df["State"])

plt.figure(figsize=(10, 6))
sns.heatmap(pivot_data, annot=True, fmt="d", cmap="YlGnBu", cbar=True)

plt.title(
    "Patient Concentration: Cancer Type vs. State",
    fontsize=14,
    fontweight="bold",
)
plt.xlabel("State", fontsize=12)
plt.ylabel("Cancer Type", fontsize=12)
plt.xticks(rotation=45, ha="right")
plt.tight_layout()
plt.show()
