# -----------------------------
# Import Libraries
# -----------------------------
import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns

from sklearn.preprocessing import LabelEncoder
from sklearn.model_selection import train_test_split
from sklearn.tree import DecisionTreeClassifier
from sklearn.metrics import accuracy_score, classification_report, confusion_matrix

# ==========================================================
# 1. BUSINESS UNDERSTANDING
# ==========================================================

print("="*60)
print("BUSINESS UNDERSTANDING")
print("="*60)

print("""
Goal:
Predict the Beverage Category of a Starbucks product
based on its beverage preparation and nutritional
information such as calories, fat, carbohydrates,
sugars, protein, caffeine and other nutrients.
""")

# ==========================================================
# 2. DATA UNDERSTANDING
# ==========================================================

print("\n" + "="*60)
print("DATA UNDERSTANDING")
print("="*60)

df = pd.read_csv("starbucks.csv")

# Remove extra spaces from column names
df.columns = df.columns.str.strip()

print("\nFirst 5 Records")
print(df.head())

print("\nDataset Shape")
print(df.shape)

print("\nColumn Names")
print(df.columns)

print("\nDataset Info")
print(df.info())

print("\nMissing Values")
print(df.isnull().sum())

print("\nStatistical Summary")
print(df.describe())

# ==========================================================
# Visualizations
# ==========================================================

plt.figure(figsize=(10, 5))
sns.histplot(df["Calories"], bins=15, kde=True)
plt.title("Distribution of Calories")
plt.xlabel("Calories")
plt.ylabel("Number of Beverages")
plt.show()

plt.figure(figsize=(10, 5))
sns.countplot(x="Beverage_category", data=df)
plt.xticks(rotation=45)
plt.title("Beverage Category Distribution")
plt.xlabel("Beverage Category")
plt.ylabel("Number of Beverages")
plt.tight_layout()
plt.show()

plt.figure(figsize=(10, 5))
sns.countplot(x="Beverage_prep", data=df)
plt.xticks(rotation=45)
plt.title("Beverage Preparation Distribution")
plt.xlabel("Beverage Preparation")
plt.ylabel("Number of Beverages")
plt.tight_layout()
plt.show()

plt.figure(figsize=(9, 5))
sns.scatterplot(
    data=df,
    x="Calories",
    y="Sugars (g)",
    hue="Beverage_category"
)
plt.title("Calories vs Sugar Content")
plt.xlabel("Calories")
plt.ylabel("Sugars (g)")
plt.legend(
    title="Beverage Category",
    bbox_to_anchor=(1.05, 1),
    loc="upper left"
)
plt.tight_layout()
plt.show()

plt.figure(figsize=(9, 5))
sns.scatterplot(
    data=df,
    x="Calories",
    y="Caffeine (mg)",
    hue="Beverage_category"
)
plt.title("Calories vs Caffeine Content")
plt.xlabel("Calories")
plt.ylabel("Caffeine (mg)")
plt.legend(
    title="Beverage Category",
    bbox_to_anchor=(1.05, 1),
    loc="upper left"
)
plt.tight_layout()
plt.show()

# ==========================================================
# 3. DATA PREPARATION
# ==========================================================

print("\n" + "="*60)
print("DATA PREPARATION")
print("="*60)

# Remove duplicates
df = df.drop_duplicates()

# Remove spaces from column names
df.columns = df.columns.str.strip()

# Remove percentage symbols from nutritional columns
percentage_columns = [
    "Vitamin A (% DV)",
    "Vitamin C (% DV)",
    "Calcium (% DV)",
    "Iron (% DV)"
]

for col in percentage_columns:
    df[col] = (
        df[col]
        .astype(str)
        .str.replace("%", "", regex=False)
        .replace("nan", np.nan)
    )
    df[col] = pd.to_numeric(df[col], errors="coerce")

# Convert numeric columns to numeric format
numeric_columns = [
    "Calories",
    "Total Fat (g)",
    "Trans Fat (g)",
    "Saturated Fat (g)",
    "Sodium (mg)",
    "Total Carbohydrates (g)",
    "Cholesterol (mg)",
    "Dietary Fibre (g)",
    "Sugars (g)",
    "Protein (g)",
    "Vitamin A (% DV)",
    "Vitamin C (% DV)",
    "Calcium (% DV)",
    "Iron (% DV)",
    "Caffeine (mg)"
]

for col in numeric_columns:
    df[col] = pd.to_numeric(df[col], errors="coerce")

# Fill missing values
for col in df.columns:
    if df[col].dtype == "object":
        df[col] = df[col].fillna(df[col].mode()[0])
    else:
        df[col] = df[col].fillna(df[col].median())

# Encode categorical variables
encoder = LabelEncoder()

categorical_columns = [
    "Beverage",
    "Beverage_prep",
    "Beverage_category"
]

for col in categorical_columns:
    df[col] = encoder.fit_transform(df[col].astype(str))

print("\nPrepared Dataset")
print(df.head())

# ==========================================================
# Features and Target
# ==========================================================

X = df.drop(["Beverage_category", "Beverage"], axis=1)
y = df["Beverage_category"]

print("\nFeature Shape :", X.shape)
print("Target Shape :", y.shape)

# ==========================================================
# 4. MODELING
# ==========================================================

print("\n" + "="*60)
print("MODELING")
print("="*60)

X_train, X_test, y_train, y_test = train_test_split(
    X,
    y,
    test_size=0.20,
    random_state=42,
    stratify=y
)

model = DecisionTreeClassifier(
    random_state=42
)

model.fit(X_train, y_train)

prediction = model.predict(X_test)

# ==========================================================
# 5. EVALUATION
# ==========================================================

print("\n" + "="*60)
print("EVALUATION")
print("="*60)

accuracy = accuracy_score(y_test, prediction)

print("Accuracy :", accuracy)

print("\nClassification Report")
print(classification_report(y_test, prediction))

print("\nConfusion Matrix")
print(confusion_matrix(y_test, prediction))

# ==========================================================
# Feature Importance
# ==========================================================

importance = pd.DataFrame({
    "Feature": X.columns,
    "Importance": model.feature_importances_
})

importance = importance.sort_values(
    by="Importance",
    ascending=False
)

print("\nFeature Importance")
print(importance)

plt.figure(figsize=(10, 6))

sns.barplot(
    data=importance,
    x="Importance",
    y="Feature"
)

plt.title("Feature Importance")
plt.xlabel("Importance")
plt.ylabel("Feature")
plt.tight_layout()
plt.show()

# ==========================================================
# Correlation Heatmap
# ==========================================================

plt.figure(figsize=(12, 8))

sns.heatmap(
    df.corr(numeric_only=True),
    annot=True,
    cmap="coolwarm"
)

plt.title("Correlation Matrix")
plt.tight_layout()
plt.show()

# ==========================================================
# 6. DEPLOYMENT
# ==========================================================

print("\n" + "="*60)
print("DEPLOYMENT")
print("="*60)

sample = X.iloc[[0]]

result = model.predict(sample)

print("Predicted Beverage Category Code :", result[0])

print("\nModel is ready for deployment.")
print("CRISP-DM Process Completed Successfully.")
